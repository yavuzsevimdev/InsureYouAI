@model List<Article>

<section id="recent-posts-4" class="widget widget_recent_entries">
    <h2 class="widget-title">Son Yazılar</h2>
    <div class="recent-blog-footer">
        <ul>
            @foreach (var item in Model)
            {
                <li>
                    <div class="thum"> <img src="@item.CoverImageUrl" alt="img"></div>
                    <div class="text">
                        <a href="# style="color:black">@item.Title</a>
                        <span class="far fa-calendar-alt"> @item.CreatedDate.ToString("dd-MMM-yyyy")</span>
                    </div>
                </li>
            }
        </ul>
    </div>
</section>
